<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        tools:context=".ui.main.MainActivity"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvTotalCasesMap"
        android:text=""
        android:textColor="@color/colorPrimaryDark"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvContract"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_default"
        android:layout_marginTop="@dimen/margin_default"
        android:layout_marginEnd="@dimen/margin_default"
        android:layout_marginBottom="@dimen/margin_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation=".1dp"
        app:cardPreventCornerOverlap="true"
        android:background="@color/white"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <View
                android:id="@+id/tvPercentageItemExt"
                android:background="@drawable/bg_circle_white_violet"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginStart="@dimen/margin_default"
                android:layout_marginEnd="@dimen/margin_default"
                android:layout_marginBottom="@dimen/margin_default"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <View
                android:id="@+id/tvPercentageItem"
                android:background="@drawable/bg_circle_primary"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginStart="@dimen/margin_default"
                android:layout_marginTop="@dimen/margin_default"
                android:layout_marginEnd="@dimen/margin_default"
                android:layout_marginBottom="@dimen/margin_default"
                app:layout_constraintTop_toTopOf="@id/tvPercentageItemExt"
                app:layout_constraintBottom_toBottomOf="@id/tvPercentageItemExt"
                app:layout_constraintStart_toStartOf="@id/tvPercentageItemExt"
                app:layout_constraintEnd_toEndOf="@id/tvPercentageItemExt" />

            <TextView
                android:id="@+id/tvIconText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="@color/colorPrimary"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/tvPercentageItemExt"
                app:layout_constraintBottom_toBottomOf="@id/tvPercentageItemExt"
                app:layout_constraintStart_toStartOf="@id/tvPercentageItemExt"
                app:layout_constraintEnd_toEndOf="@id/tvPercentageItemExt" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/bariol_bold"
                android:text="Status"
                android:textSize="8sp"
                app:layout_constraintEnd_toEndOf="@+id/tvPercentageItemExt"
                app:layout_constraintStart_toStartOf="@+id/tvPercentageItemExt"
                app:layout_constraintTop_toBottomOf="@+id/tvPercentageItemExt" />

            <TextView
                android:id="@+id/tvSex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableLeft="@drawable/ic_female_icon"
                android:fontFamily="@font/bariol_regular"
                android:drawablePadding="2dp"
                android:gravity="left|center"
                android:paddingBottom="4dp"
                android:text=""
                android:textColor="@color/common_google_signin_btn_text_light_default"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@+id/tvPercentageItemExt"
                app:layout_constraintEnd_toEndOf="@+id/tvPercentageItemExt"
                app:layout_constraintTop_toBottomOf="@+id/tvStatus" />

            <TextView
                android:id="@+id/tvNameItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_default"
                android:layout_marginTop="@dimen/margin_default"
                android:layout_marginEnd="@dimen/margin_default"
                android:fontFamily="@font/bariol_bold"
                android:text="Name"
                android:gravity="left|center"
                android:textColor="@color/common_google_signin_btn_text_light_default"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/tvPercentageItemExt"
                app:layout_constraintTop_toTopOf="@+id/tvPercentageItemExt"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvLocationItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_default"
                android:layout_marginEnd="@dimen/margin_default"
                android:layout_marginBottom="@dimen/margin_default"
                android:layout_marginTop="@dimen/margin_default"
                android:fontFamily="@font/bariol_regular"
                android:gravity="left|center"
                android:text="sdafoj alsdjf alsjfd alsjdf alsfj aslofj alsfj alsfdj alsfjals fjalsfj aslfja slfjaslfj alsjfalsfj alsfj alsfj lasf"
                android:textColor="@color/common_google_signin_btn_text_light_default"
                android:textSize="12sp"
                android:drawableLeft="@drawable/ic_position"
                android:drawablePadding="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvPercentageItemExt"
                app:layout_constraintTop_toBottomOf="@+id/tvNameItem"/>

            <TextView
                android:id="@+id/tvDateItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_default"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="@dimen/margin_default"
                android:fontFamily="@font/bariol_regular"
                android:drawableLeft="@drawable/ic_time"
                android:drawablePadding="2dp"
                android:gravity="left|center"
                android:text="Date"
                android:textColor="@color/common_google_signin_btn_text_light_default"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@+id/tvPercentageItemExt"
                app:layout_constraintTop_toBottomOf="@+id/tvLocationItem" />

            <TextView
                android:id="@+id/tvDateConfirmationItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_default"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="@dimen/margin_default"
                android:fontFamily="@font/bariol_regular"
                android:drawableLeft="@drawable/ic_check_date"
                android:drawablePadding="2dp"
                android:gravity="left|center"
                android:text="Date"
                android:textColor="@color/common_google_signin_btn_text_light_default"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvPercentageItemExt"
                app:layout_constraintTop_toBottomOf="@+id/tvDateItem" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
